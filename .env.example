# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_xxxxx
TRIGGER_SCRAPE_TASK_ID=scrape-jobs

# Scraper
WWR_RSS_URL=https://weworkremotely.com/categories/remote-programming-jobs.rss
SCRAPER_REQUEST_DELAY=1.0
SCRAPER_USER_AGENT=AutomindzJobBot/0.1 (+https://example.com/bot)

# Cache: re-scrape when newest row for a query is older than this (hours)
CACHE_TTL_HOURS=24

# Hugging Face Inference (optional; used when LLM_PROVIDER=hf)
HF_TOKEN=
HF_MODEL=moonshotai/Kimi-K3:together
HF_BASE_URL=https://router.huggingface.co/v1

# Local Ollama (optional)
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3:latest

# OpenRouter (default for CV match)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=1200

# Optional: how long match-cv waits for fresh scrapes (seconds)
MATCH_SCRAPE_WAIT_SECONDS=8
