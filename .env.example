# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
# Optional: comma-separated origins for CORS (web origin)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5500

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_xxxxx
# Public webhook / trigger ID used by the API to start a scrape run
TRIGGER_SCRAPE_TASK_ID=scrape-weworkremotely

# Scraper
WWR_RSS_URL=https://weworkremotely.com/categories/remote-programming-jobs.rss
# Delay between detail-page fetches (seconds)
SCRAPER_REQUEST_DELAY=1.0
SCRAPER_USER_AGENT=AutomindzJobBot/0.1 (+https://example.com/bot)
